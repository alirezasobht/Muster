<?xml version="1.0" encoding="utf-8"?>
<!-- Compose Resources does not use Android's backslash escaping: \' renders
     as a literal backslash. Apostrophes go in directly, as ’ to match the
     typography in docs/design. -->
<resources>

    <!-- Launch (1q, 1r) -->
    <string name="launch_failed_title">Couldn’t reach Muster</string>
    <string name="launch_failed_body">Check your connection and try again. Nothing has been lost.</string>
    <string name="launch_try_again">Try again</string>

    <!-- Sign in (1a) -->
    <string name="request_code_title">Sign in</string>
    <string name="request_code_subtitle">We’ll email you a six-digit code. There are no passwords.</string>
    <string name="request_code_send">Send code</string>
    <string name="request_code_footer">No sign-up needed. Your email becomes your account, and it can’t be changed later.</string>

    <!-- Enter code (1b) -->
    <string name="enter_code_title">Enter your code</string>
    <string name="enter_code_sent_to">Sent to %1$s</string>
    <string name="enter_code_resend_in">Resend code in %1$s</string>
    <string name="enter_code_resend">Resend code</string>

    <!-- Set name (1c) -->
    <string name="set_name_title">What should we call you?</string>
    <string name="set_name_subtitle">Your teammates see this name on rosters.</string>

    <!-- Home placeholder -->
    <string name="home_signed_in_as">Signed in as %1$s</string>

    <!-- Shared -->
    <string name="action_continue">Continue</string>
    <string name="action_sign_out">Sign out</string>
    <string name="field_email">Email</string>
    <string name="field_name">Name</string>
    <string name="content_description_back">Back</string>

    <!-- Errors: one per DomainError case -->
    <string name="error_invalid_email">That doesn’t look like an email address.</string>
    <string name="error_invalid_code">That code is wrong or has expired.</string>
    <string name="error_rate_limited">Too many attempts. Wait a minute and try again.</string>
    <string name="error_invalid_name">Enter your name.</string>
    <string name="error_network">Can’t connect. Check your connection and try again.</string>
    <string name="error_not_signed_in">You’ve been signed out. Sign in again.</string>
    <string name="error_unknown">Something went wrong. Try again.</string>

</resources>
