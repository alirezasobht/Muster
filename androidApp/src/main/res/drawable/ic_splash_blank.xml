<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately invisible, not empty. Leaving windowSplashScreenAnimatedIcon
     unset makes Android draw the launcher icon instead, and a vector with no
     path at all is treated as invalid and falls back the same way. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0 H108 V108 H0 Z" />
</vector>
