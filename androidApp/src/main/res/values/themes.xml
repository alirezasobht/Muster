<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Muster" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!-- Plain green, no icon: the system splash is indistinguishable from the
         Compose launch screen (1q) behind it, so there is no visible handoff. -->
    <style name="Theme.Muster.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/muster_accent</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Muster</item>
    </style>

</resources>
